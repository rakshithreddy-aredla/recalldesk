# ---- RecallDesk app (backend/.env) ----
# Free Groq tier is fine here — these keys power the support replies only
GROQ_API_KEY=your_groq_api_key
HINDSIGHT_API_URL=http://localhost:8888
# Only set when using Hindsight Cloud (then HINDSIGHT_API_URL points at your cloud instance URL)
HINDSIGHT_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# ---- Hindsight server's internal LLM (only needed for LOCAL hindsight-api) ----
# NOTE: Groq FREE tier cannot power the server (a single retain call needs ~64k
# output tokens; free Groq is capped at 8k tokens/min).
# Option A (free): Gemini API key from Google AI Studio (https://aistudio.google.com)
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_API_KEY=
# Option B (paid): paid Groq tier or OpenAI key
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
